#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D gDepth;
layout(binding = 1) uniform sampler2DArrayShadow shadowMapArray;
layout(binding = 2, r16f) uniform writeonly image2D outVolumetricFog;

layout(push_constant) uniform PushConstants {
    mat4 invViewProj;
    mat4 lightViewProj[3];
    vec4 sunDir;     // xyz = direction, w = intensity
    vec4 camPos;     // xyz = position, w = time
    vec4 skyFogColor;
} pc;

float interleavedGradientNoise(vec2 screenPos) {
    vec3 magic = vec3(0.06711056, 0.00583715, 52.9829189);
    return fract(magic.z * fract(dot(screenPos, magic.xy)));
}

float henyeyGreenstein(float cosTheta, float g) {
    float g2 = g * g;
    return (1.0 / (4.0 * 3.14159265)) * ((1.0 - g2) / pow(1.0 + g2 - 2.0 * g * cosTheta, 1.5));
}

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outDim = imageSize(outVolumetricFog);
    if (pixelCoord.x >= outDim.x || pixelCoord.y >= outDim.y) return;

    vec2 uv = (vec2(pixelCoord) + 0.5) / vec2(outDim);
    float depth = texture(gDepth, uv).r;

    vec4 clip = vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec4 worldTarget = pc.invViewProj * clip;
    worldTarget.xyz /= worldTarget.w;

    vec3 ro = pc.camPos.xyz;
    vec3 rd = worldTarget.xyz - ro;
    float maxDist = min(length(rd), 65.0);
    rd = normalize(rd);

    const int STEPS = 20;
    float stepSize = maxDist / float(STEPS);
    float dither = interleavedGradientNoise(vec2(pixelCoord));
    float currentDist = stepSize * dither;

    float cosTheta = dot(rd, normalize(pc.sunDir.xyz));
    float phase = henyeyGreenstein(cosTheta, 0.74);

    float inScatter = 0.0;
    for (int i = 0; i < STEPS; ++i) {
        vec3 p = ro + rd * currentDist;
        int cascade = (currentDist < 16.0) ? 0 : 1;

        vec4 lightSpace = pc.lightViewProj[cascade] * vec4(p, 1.0);
        vec3 projCoords = lightSpace.xyz / lightSpace.w;
        projCoords.xy = projCoords.xy * 0.5 + 0.5;

        if (projCoords.z >= 0.0 && projCoords.z <= 1.0 &&
            projCoords.x >= 0.0 && projCoords.x <= 1.0 &&
            projCoords.y >= 0.0 && projCoords.y <= 1.0) {
            float shadow = texture(shadowMapArray, vec4(projCoords.xy, float(cascade), projCoords.z - 0.001));
            inScatter += shadow * phase * stepSize;
        }
        currentDist += stepSize;
    }

    imageStore(outVolumetricFog, pixelCoord, vec4(inScatter * pc.sunDir.w * 0.40));
}
